        "dishes_meal_type_valid": {
          "name": "dishes_meal_type_valid",
          "value": "\"dishes\".\"meal_type\" in ('buacom', 'buatomonuoc')"
        },
        "dishes_category_rule": {
          "name": "dishes_category_rule",
          "value": "(\"dishes\".\"meal_type\" = 'buacom' and \"dishes\".\"category\" is not null and \"dishes\".\"category\" in ('xao', 'canh', 'man')) or (\"dishes\".\"meal_type\" = 'buatomonuoc' and \"dishes\".\"category\" is null)"
        },
        "dishes_region_valid": {
          "name": "dishes_region_valid",
          "value": "\"dishes\".\"region\" is null or \"dishes\".\"region\" in ('bac', 'trung', 'nam')"
        },
        "dishes_ingredients_nonempty": {
          "name": "dishes_ingredients_nonempty",
          "value": "cardinality(\"dishes\".\"ingredients\") > 0"
        },
        "dishes_time_positive": {
          "name": "dishes_time_positive",
          "value": "\"dishes\".\"time_minutes\" is null or \"dishes\".\"time_minutes\" > 0"

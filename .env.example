# Pooled connection used by the Route Handlers (Neon HTTP driver). Provided by the Vercel Neon integration.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Direct (unpooled) connection used by `pnpm db:migrate` and `pnpm db:seed`. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Admin page (/admin). Without BOTH of these the admin reports itself unavailable.
# The password the Quản trị viên signs in with.
ADMIN_PASSPHRASE=
# Signs the 7-day session cookie; at least 32 characters, e.g. `openssl rand -base64 48`.
ADMIN_SESSION_SECRET=
